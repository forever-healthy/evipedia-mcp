{
  "name": "evipedia-mcp",
  "version": "0.1.14",
  "description": "MCP Server for evipedia.ai — evidence-based reviews of health & longevity interventions",
  "type": "module",
  "bin": {
    "evipedia-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --clean",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "mcp",
    "evipedia",
    "longevity",
    "health",
    "evidence-based"
  ],
  "author": "Forever Healthy Foundation",
  "license": "MIT",
  "homepage": "https://evipedia.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/forever-healthy/evipedia-mcp.git"
  }
}
